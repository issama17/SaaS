# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored — never commit real credentials.

# ---------------------------------------------------------------------------
# Base de données (PostgreSQL / Supabase)
# ---------------------------------------------------------------------------

# Connexion utilisée par l'application au runtime.
# Supabase : Project Settings → Database → Connection string → Transaction pooler
# (port 6543). `pgbouncer=true` est requis, le pooler ne gère pas les prepared
# statements.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connexion directe (port 5432), utilisée par les commandes Prisma CLI :
# `prisma migrate`, `prisma db push`, `prisma studio`. Le pooler ne sait pas
# exécuter de migrations. Sur une base Postgres classique, reprenez simplement
# la même valeur que DATABASE_URL.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Authentification
# ---------------------------------------------------------------------------

# Le cookie de session est posé avec l'attribut `Secure` par défaut, ce qui
# empêche de se connecter sur http://localhost. Mettre "false" en local
# uniquement — ne jamais définir cette variable en production.
# SESSION_COOKIE_SECURE="false"
